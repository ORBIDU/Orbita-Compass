# Salin file ini menjadi .env lalu sesuaikan nilainya.

# true  → semua data memakai dummy dari src/mocks/ (termasuk login),
#         jadi frontend bisa jalan tanpa backend. Muncul panel "Mode Demo".
# false → memakai backend sungguhan di VITE_API_BASE_URL.
VITE_USE_MOCK=true

# Alamat backend-api (dipakai saat VITE_USE_MOCK=false).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Akun demo (sama di mode dummy dan seed backend):
#   siswa@orbita.id / password123  → status "aktif"
#   budi@orbita.id  / password123  → status "sudah_asesmen"
# Akun baru hasil halaman Daftar selalu mulai dengan status "baru".
